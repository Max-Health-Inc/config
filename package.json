{
  "name": "@max-health-inc/config",
  "version": "5.1.0",
  "description": "Shared configs (tsconfig, eslint, vite, vitest), the doccheck doc-quality CLI and check tooling (tsgo, run-parallel, wrangler-check) for Max Health repos",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Health-Inc/config.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./tsconfig/app.json": "./tsconfig/app.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/worker.json": "./tsconfig/worker.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/test-bun.json": "./tsconfig/test-bun.json",
    "./tsconfig/test-vitest.json": "./tsconfig/test-vitest.json",
    "./eslint/react": "./eslint/react.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/rules": "./eslint/rules.js",
    "./oxlint/type-aware.json": "./oxlint/type-aware.json",
    "./oxlint/type-aware-bun.json": "./oxlint/type-aware-bun.json",
    "./oxlint/config": "./oxlint/config.js",
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.js"
    },
    "./vite/release": {
      "types": "./vite/release.d.ts",
      "default": "./vite/release.js"
    },
    "./vite/mcp-app": {
      "types": "./vite/mcp-app.d.ts",
      "default": "./vite/mcp-app.js"
    },
    "./vite/release-notes": {
      "types": "./vite/release-notes.d.ts",
      "default": "./vite/release-notes.js"
    },
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    },
    "./doccheck": {
      "types": "./doccheck/index.d.ts",
      "default": "./doccheck/index.js"
    }
  },
  "bin": {
    "doccheck": "./doccheck/cli.js",
    "release-version": "./vite/release-cli.js",
    "release-tag": "./vite/release-tag-cli.js",
    "wrangler-check": "./wrangler/check-cli.js",
    "run-parallel": "./parallel/cli.js",
    "tsgo": "./tsgo/cli.js"
  },
  "files": [
    "tsconfig",
    "types",
    "eslint",
    "oxlint",
    "vite",
    "vitest",
    "doccheck",
    "wrangler",
    "parallel",
    "tsgo",
    "!eslint/*.test.js",
    "!oxlint/*.test.js",
    "!oxlint/generate.js",
    "!vite/*.test.js",
    "!wrangler/*.test.js",
    "!doccheck/*.test.js",
    "!parallel/*.test.js",
    "!tsgo/*.test.js"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "@typescript/typescript-aix-ppc64": "^7.0.2",
    "@typescript/typescript-darwin-arm64": "^7.0.2",
    "@typescript/typescript-darwin-x64": "^7.0.2",
    "@typescript/typescript-freebsd-arm64": "^7.0.2",
    "@typescript/typescript-freebsd-x64": "^7.0.2",
    "@typescript/typescript-linux-arm": "^7.0.2",
    "@typescript/typescript-linux-arm64": "^7.0.2",
    "@typescript/typescript-linux-loong64": "^7.0.2",
    "@typescript/typescript-linux-mips64el": "^7.0.2",
    "@typescript/typescript-linux-ppc64": "^7.0.2",
    "@typescript/typescript-linux-riscv64": "^7.0.2",
    "@typescript/typescript-linux-s390x": "^7.0.2",
    "@typescript/typescript-linux-x64": "^7.0.2",
    "@typescript/typescript-netbsd-arm64": "^7.0.2",
    "@typescript/typescript-netbsd-x64": "^7.0.2",
    "@typescript/typescript-openbsd-arm64": "^7.0.2",
    "@typescript/typescript-openbsd-x64": "^7.0.2",
    "@typescript/typescript-sunos-x64": "^7.0.2",
    "@typescript/typescript-win32-arm64": "^7.0.2",
    "@typescript/typescript-win32-x64": "^7.0.2"
  },
  "peerDependencies": {
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "globals": ">=15",
    "typescript-eslint": ">=8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "scripts": {
    "generate": "node oxlint/generate.js",
    "test": "node --test \"vite/*.test.js\" \"eslint/*.test.js\" \"oxlint/*.test.js\" \"wrangler/*.test.js\" \"doccheck/*.test.js\" \"parallel/*.test.js\" \"tsgo/*.test.js\""
  }
}
