{
  "name": "@max-health-inc/config",
  "version": "3.3.0",
  "description": "Shared configs (tsconfig, eslint, vite, vitest) and the doccheck doc-quality CLI for Max Health repos",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Health-Inc/config.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./tsconfig/app.json": "./tsconfig/app.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/worker.json": "./tsconfig/worker.json",
    "./tsconfig/test-bun.json": "./tsconfig/test-bun.json",
    "./tsconfig/test-vitest.json": "./tsconfig/test-vitest.json",
    "./eslint/react": "./eslint/react.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/rules": "./eslint/rules.js",
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.js"
    },
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    },
    "./doccheck": {
      "types": "./doccheck/index.d.ts",
      "default": "./doccheck/index.js"
    }
  },
  "bin": {
    "doccheck": "./doccheck/cli.js"
  },
  "files": ["tsconfig", "types", "eslint", "vite", "vitest", "doccheck"],
  "license": "MIT",
  "peerDependencies": {
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "globals": ">=15",
    "typescript-eslint": ">=8"
  }
}
