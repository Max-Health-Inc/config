{
  "name": "@max-health-inc/config",
  "version": "3.0.1",
  "description": "Shared configs (tsconfig, eslint, vite, vitest) for Max Health repos",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Health-Inc/config.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./tsconfig/app.json": "./tsconfig/app.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/worker.json": "./tsconfig/worker.json",
    "./eslint/react": "./eslint/react.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/rules": "./eslint/rules.js",
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.js"
    },
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    }
  },
  "files": ["tsconfig", "eslint", "vite", "vitest"],
  "license": "MIT",
  "peerDependencies": {
    "@eslint/js": ">=9",
    "@tailwindcss/vite": ">=4",
    "@vitejs/plugin-react-swc": ">=4",
    "eslint": ">=9",
    "eslint-plugin-react-hooks": ">=5",
    "eslint-plugin-react-refresh": ">=0.4",
    "globals": ">=15",
    "typescript-eslint": ">=8",
    "vite": ">=6",
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": { "optional": true },
    "@vitejs/plugin-react-swc": { "optional": true },
    "eslint-plugin-react-hooks": { "optional": true },
    "eslint-plugin-react-refresh": { "optional": true },
    "vite": { "optional": true },
    "vitest": { "optional": true }
  }
}
